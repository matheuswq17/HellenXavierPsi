# Após registrar o domínio e configurar HTTPS, informe a origem sem barra final.
# Enquanto vazio, o site permanece protegido contra indexação.
PUBLIC_SITE_URL=

# Google tag (carregada só no build de produção e só se preenchida).
# ID da tag do Google (GA4 "G-XXXXXXXXXX" ou Google Ads "AW-XXXXXXXXX").
PUBLIC_GOOGLE_TAG_ID=
# Conversão do Google Ads para clique no WhatsApp, no formato "AW-XXXXXXXXX/rotulo".
PUBLIC_GADS_CONVERSION_WHATSAPP=
