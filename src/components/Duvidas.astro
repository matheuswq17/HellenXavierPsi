---
import { site } from "../site.config";
import { rich, waLink } from "../lib/text";
interface Props { itens?: readonly { p: string; r: string }[]; titulo?: string; comGuia?: boolean; id?: string }
const { itens = site.faq, titulo = "Perguntas frequentes", comGuia = true, id = "duvidas" } = Astro.props;
const g = site.guia;
---
<section class="secao du" id={id} data-bg="#dfe5d8">
  <div class="wrap du__grid">
    <div>
      <p class="eyebrow" data-reveal>Dúvidas</p>
      <h2 data-split>{titulo}</h2>
      {comGuia && (
        <div class="du__guia" data-reveal>
          <h3>{g.titulo}</h3>
          <ul>{g.sinais.map((s) => <li>{s}</li>)}</ul>
          <p class="du__nota">{g.nota}</p>
          <a class="link" href={waLink(site.contato.whatsapp, site.mensagens.guia)} data-origem="duvidas" target="_blank" rel="noopener">Conversar sobre isso</a>
        </div>
      )}
    </div>
    <div class="du__lista">
      {itens.map((f) => (
        <details class="du__item" data-reveal>
          <summary><span>{f.p}</span><i aria-hidden="true"></i></summary>
          <div class="du__r"><p set:html={rich(f.r)} /></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .du__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 7vw, 120px); align-items: start; }
  .du__guia { margin-top: 48px; background: color-mix(in srgb, var(--linho) 75%, transparent); border-radius: 22px; padding: 28px; }
  .du__guia h3 { font-size: 1.5rem; color: var(--floresta); margin-bottom: 14px; }
  .du__guia ul { padding-left: 18px; margin: 0 0 14px; color: var(--tinta-suave); display: grid; gap: 6px; }
  .du__nota { font-size: 0.85rem; color: var(--tinta-suave); }
  .du__item { border-bottom: 1px solid var(--linha); }
  .du__item:first-child { border-top: 1px solid var(--linha); }
  .du__item summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 24px 0; font-family: var(--serif); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.3;
  }
  .du__item summary::-webkit-details-marker { display: none; }
  .du__item i { width: 16px; height: 16px; position: relative; flex: none; }
  .du__item i::before, .du__item i::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--floresta); transition: transform 0.5s var(--ease); }
  .du__item i::after { transform: rotate(90deg); }
  .du__item[open] i::after { transform: rotate(0); }
  .du__r { color: var(--tinta-suave); padding: 0 40px 20px 0; }
  .du__item[open] .du__r { animation: abrir 0.5s var(--ease); }
  @keyframes abrir { from { opacity: 0; transform: translateY(-6px); } }
  @media (max-width: 860px) { .du__grid { grid-template-columns: 1fr; } }
</style>
