---
import { Picture } from "astro:assets";
import { site } from "../site.config";
import { waLink } from "../lib/text";
import heroImg from "../assets/fotos/hero-preto.jpg";
const h = site.hero;

/*
 * Abertura em camadas ("2.5D"): se existirem src/assets/hero/fundo.jpg (consultório vazio)
 * e src/assets/hero/pessoa.png (recorte da Hellen com fundo transparente), o hero vira
 * duas camadas: o fundo ganha vida (vídeo de luz/plantas) e a Hellen continua sendo a FOTO
 * REAL, intacta. O movimento de câmera é feito no navegador (parallax entre as camadas).
 * Sem esses arquivos, o hero usa a foto normal.
 */
const camadas = import.meta.glob<{ default: ImageMetadata }>("../assets/hero/*.{jpg,png,webp}", { eager: true });
const fundoImg = camadas["../assets/hero/fundo.jpg"]?.default;
const pessoaImg = camadas["../assets/hero/pessoa.png"]?.default;
const emCamadas = !!(fundoImg && pessoaImg);
const alt = "Retrato de Hellen Xavier sorrindo, de blazer preto";
---
<section class="hero" data-hero data-bg="#faf5f0">
  <div class="hero__midia" data-hero-midia>
    {emCamadas ? (
      <>
        <div class="hero__camada hero__camada--fundo" data-camada-fundo>
          <Picture src={fundoImg!} formats={["avif", "webp"]} widths={[640, 960, 1280, 1672]} sizes="100vw"
            alt="" loading="eager" fetchpriority="high" class="hero__img" />
          {(h.video.desktop || h.video.mobile) && (
            <video class="hero__video" muted playsinline loop preload="none" aria-hidden="true" data-hero-video
              data-src-desktop={h.video.desktop} data-src-mobile={h.video.mobile || h.video.desktop} />
          )}
        </div>
        <div class="hero__camada hero__camada--pessoa" data-camada-pessoa>
          <Picture src={pessoaImg!} formats={["avif", "webp"]} widths={[640, 960, 1280, 1672]} sizes="100vw"
            alt={alt} loading="eager" fetchpriority="high" class="hero__img" />
        </div>
      </>
    ) : (
      <>
        <Picture src={heroImg} formats={["avif", "webp"]} widths={[640, 960, 1280, 1672]} sizes="100vw"
          alt={alt} loading="eager" fetchpriority="high" class="hero__img" data-hero-img />
        {(h.video.desktop || h.video.mobile) && (
          <video class="hero__video" muted playsinline loop preload="none" aria-hidden="true" data-hero-video
            data-src-desktop={h.video.desktop} data-src-mobile={h.video.mobile || h.video.desktop} />
        )}
      </>
    )}
    <div class="hero__veu" aria-hidden="true"></div>
  </div>

  <div class="hero__txt">
    <p class="eyebrow" data-reveal>{h.eyebrow}</p>
    <p class="hero__publico">Adolescentes e adultos · Particular</p>
    <h1 data-split>
      {h.h1} <em>{h.h1Local}</em>
    </h1>
    <p class="lead" data-reveal>{h.apoio}</p>
    <div class="hero__cta">
      <a class="btn" href={waLink(site.contato.whatsapp, site.mensagens.geral)} target="_blank" rel="noopener">
        {h.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn--ghost" href="/avaliacao-neuropsicologica">{h.ctaSecundario}</a>
      <a class="link" href="/psicoterapia-tcc">Entender a psicoterapia</a>
    </div>
    <p class="hero__nota">Consulte valores e horários. O contato não confirma uma sessão.</p>
  </div>

  <a href="#para-quem" class="hero__rolar" aria-label="Rolar para a próxima seção" data-reveal>
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: grid; align-items: center;
    overflow: hidden;
  }
  .hero__midia { position: absolute; inset: 0; overflow: hidden; }
  .hero__camada { position: absolute; inset: 0; will-change: transform; }
  .hero__camada--pessoa { transform: scale(1.03); transform-origin: 30% 100%; }
  .hero__midia :global(img),
  .hero__video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 28% 40%;
  }
  .hero__video { opacity: 0; transition: opacity 1.6s var(--ease); }
  .hero__video.is-ready { opacity: 1; }
  .hero__veu {
    position: absolute; inset: 0;
    background:
      linear-gradient(270deg, rgba(250, 245, 240, 0.95) 0%, rgba(250, 245, 240, 0.82) 34%, rgba(250, 245, 240, 0) 56%),
      linear-gradient(0deg, var(--bg) 0%, rgba(250, 245, 240, 0) 22%);
  }
  .hero__txt {
    position: relative; z-index: 1;
    width: min(500px, 37vw); margin-left: auto; margin-right: max(var(--gutter), calc((100vw - 1400px) / 2));
    padding-top: 84px;
  }
  .hero h1 { font-size: clamp(2.2rem, 3.5vw, 3.6rem); color: var(--tinta); }
  .hero h1 em { display: block; }
  .hero .lead { margin-top: 28px; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
  .hero__publico { font-size: .9rem; color: var(--tinta-suave); margin-bottom: 14px; }
  .hero__cta .link { align-self: center; }
  .hero__nota { font-size: .85rem; color: var(--tinta-suave); margin-top: 14px; }
  .hero__rolar {
    position: absolute; left: 50%; bottom: 28px; translate: -50% 0; width: 26px; height: 42px;
    border-radius: 20px; box-shadow: inset 0 0 0 1.5px var(--linha); z-index: 1;
  }
  .hero__rolar span {
    position: absolute; left: 50%; top: 9px; width: 3px; height: 8px; border-radius: 2px; background: var(--floresta);
    translate: -50% 0; animation: rolar 2.4s var(--ease) infinite;
  }
  @keyframes rolar { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 80% { opacity: 0; transform: translateY(12px); } 100% { opacity: 0; } }

  @media (max-width: 560px) { .hero h1 { font-size: 2rem; } .hero .lead { margin-top: 16px; font-size: 1rem; } .hero__cta { margin-top: 20px; } }
  @media (max-width: 860px) {
    .hero { min-height: auto; display: block; }
    .hero__midia { position: relative; height: 28svh; min-height: 160px; margin-top: 84px; }
    .hero__midia :global(img), .hero__video { object-position: 30% 30%; }
    .hero__veu { background: linear-gradient(0deg, var(--bg) 0%, rgba(250, 245, 240, 0) 30%); }
    .hero__txt { width: auto; margin: -12px var(--gutter) 0; padding: 0 0 72px; }
    .hero__rolar { display: none; }
  }
  @media (max-width: 560px) and (max-height: 700px) { .hero__midia { height: 140px; min-height: 140px; } .hero h1 { font-size: 1.65rem; } .hero .eyebrow { font-size: .64rem; letter-spacing: .06em; margin-bottom: 8px; } .hero__publico { font-size: .8rem; } .hero__cta .btn { padding-inline: 18px; } .hero__cta svg { display: none; } .hero .lead { font-size: .95rem; line-height: 1.5; } .hero__cta { margin-top: 14px; } }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  if (v && !conn?.saveData && !/2g/.test(conn?.effectiveType || "")) {
    let visible = false;
    let loaded = document.readyState === "complete";
    const sync = () => {
      const allowed = loaded && visible && !document.hidden && !document.documentElement.hasAttribute("data-calmo");
      if (!allowed) { v.pause(); return; }
      if (!v.getAttribute("src")) {
        v.src = (matchMedia("(max-width: 860px)").matches ? v.dataset.srcMobile : v.dataset.srcDesktop) || "";
      }
      v.play().then(() => v.classList.add("is-ready")).catch(() => {});
    };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(v.closest("[data-hero-midia]")!);
    addEventListener("load", () => { loaded = true; sync(); }, { once: true });
    document.addEventListener("visibilitychange", sync);
    document.addEventListener("calmo", sync);
  }
</script>
