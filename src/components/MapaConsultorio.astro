---
/**
 * Mapa do consultório desenhado com as ruas reais (OpenStreetMap), nas cores do site.
 * Sem iframe, sem script de terceiros, sem cookies: é um SVG leve que abre o Google Maps/Waze no clique.
 */
import { site } from "../site.config";
import Logo from "./Logo.astro";
import { MAPA_VIEWBOX, PONTOS, RUAS } from "./mapaRuas";

const c = site.contato;
const [cx, cy] = PONTOS.consultorio;
const [mx, my] = PONTOS.metro;
const [sx, sy] = PONTOS.shoppingTucuruvi;
const [tx, ty] = PONTOS.trimais;
// Arco pontilhado metrô → consultório (indica a distância, não uma rota exata).
const arco = `M${mx - 6} ${my + 8} Q 392 304 ${cx + 14} ${cy + 12}`;
---
<div class="mapa" data-mapa>
  <a class="mapa__quadro" href={c.mapsUrl} target="_blank" rel="noopener"
     aria-label={`Abrir no Google Maps: ${c.predio}, ${c.endereco}, ${c.bairro}`}>
    <svg class="mapa__svg" viewBox={MAPA_VIEWBOX} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id="mapa-luz" cx={cx / 760} cy={cy / 430} r="0.75">
          <stop offset="0" stop-color="#fffdf9" stop-opacity="0.9" />
          <stop offset="1" stop-color="#fffdf9" stop-opacity="0" />
        </radialGradient>
        <path id="mapa-rotulo-cantareira" d="M120 386 L214 266" />
      </defs>

      <rect class="mapa__fundo" x="-40" y="-40" width="840" height="510" />
      <rect x="-40" y="-40" width="840" height="510" fill="url(#mapa-luz)" />

      <g class="mapa__ruas" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path class="r r--res" d={RUAS.residencial} />
        <path class="r r--ter" d={RUAS.terciaria} />
        <path class="r r--sec" d={RUAS.secundaria} />
        <path class="r r--pri" d={RUAS.primaria} />
        <path class="r r--cant" d={RUAS.cantareira} pathLength="1" />
        <path class="r r--metro" d={RUAS.metro} />
      </g>

      <text class="mapa__rua"><textPath href="#mapa-rotulo-cantareira">Av. Nova Cantareira</textPath></text>

      <g class="mapa__ref" transform={`translate(${mx} ${my})`}>
        <g class="mapa__metro"><circle r="9" class="mapa__metro-anel" />
        <text class="mapa__metro-m" y="4.2" text-anchor="middle">M</text></g>
        <text class="mapa__ref-txt mapa__ref-txt--metro" x="0" y="35" text-anchor="middle">Metrô Tucuruvi</text>
      </g>
      <g class="mapa__ref" transform={`translate(${sx} ${sy})`}>
        <circle r="3.5" class="mapa__ponto" />
        <text class="mapa__ref-txt mapa__ref-txt--suave" x="-2" y="-12" text-anchor="end">Shopping Tucuruvi</text>
      </g>
      <g class="mapa__ref" transform={`translate(${tx} ${ty})`}>
        <circle r="3.5" class="mapa__ponto" />
        <text class="mapa__ref-txt mapa__ref-txt--suave mapa__ref-txt--trimais" x="9" y="20">Shopping TriMais</text>
      </g>

      <path class="mapa__arco" d={arco} fill="none" />
      <text class="mapa__dist" x="392" y="276" text-anchor="middle">≈ 950 m</text>

      <g class="mapa__pin" transform={`translate(${cx} ${cy})`}>
        <g class="mapa__onda-g">
          <circle class="mapa__onda" r="17" />
          <circle class="mapa__onda mapa__onda--2" r="17" />
        </g>
        <g class="mapa__pin-corpo">
          <circle r="19" class="mapa__pin-disco" />
          <Logo class="mapa__pin-logo" x="-11" y="-12.5" width="22" height="25" />
        </g>
        <text class="mapa__pin-txt" x="0" y="-30" text-anchor="middle">{c.predio.replace("Edifício ", "")}</text>
      </g>
    </svg>
    <span class="mapa__abrir">Abrir no Google Maps <span aria-hidden="true">↗</span></span>
    <span class="mapa__credito">© OpenStreetMap</span>
  </a>

  <div class="mapa__info">
    <p class="eyebrow">Como chegar</p>
    <h3 class="mapa__titulo">{c.predio}</h3>
    <p class="mapa__end">{c.endereco}<br />{c.bairro}, {c.cidade} · CEP {c.cep}</p>
    <ul class="mapa__acesso">
      {c.acesso.map((i) => <li>{i}</li>)}
    </ul>
    <div class="mapa__acoes">
      <a class="btn" href={c.rotaUrl} target="_blank" rel="noopener">Traçar rota</a>
      <a class="link" href={c.wazeUrl} target="_blank" rel="noopener">Abrir no Waze</a>
    </div>
  </div>
</div>

<style>
  .mapa {
    display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px); align-items: center;
  }
  .mapa__quadro {
    position: relative; display: block; border-radius: 22px; overflow: hidden;
    aspect-ratio: 760 / 430; color: inherit; text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--linha);
    isolation: isolate;
  }
  .mapa__svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: -1; }
  .mapa__svg { transition: transform 1.2s var(--ease); transform-origin: 26% 45%; }
  .mapa__quadro:hover .mapa__svg { transform: scale(1.02); }

  .mapa__fundo { fill: var(--linho); }
  .r { stroke: var(--floresta); }
  .r--res { stroke-width: 1.3; stroke-opacity: 0.13; }
  .r--ter { stroke-width: 2.2; stroke-opacity: 0.18; }
  .r--sec { stroke-width: 3.2; stroke-opacity: 0.22; }
  .r--pri { stroke-width: 4.2; stroke-opacity: 0.26; }
  .r--cant { stroke-width: 5.2; stroke-opacity: 0.62; }
  .r--metro { stroke: var(--terracota); stroke-width: 2.4; stroke-opacity: 0.75; stroke-dasharray: 1 6; }

  .mapa__rua {
    font: italic 400 13px var(--serif); fill: var(--floresta); letter-spacing: 0.02em;
    paint-order: stroke; stroke: var(--linho); stroke-width: 4px; stroke-linejoin: round;
  }
  .mapa__ref-txt {
    font: 600 12.5px var(--sans); fill: var(--tinta);
    paint-order: stroke; stroke: var(--linho); stroke-width: 4px; stroke-linejoin: round;
  }
  .mapa__ref-txt--suave { font-weight: 500; fill: var(--tinta-suave); }
  .mapa__metro { transform: scale(var(--s, 1)); }
  .mapa__metro-anel { fill: var(--linho); stroke: var(--terracota); stroke-width: 2; }
  .mapa__metro-m { font: 700 10.5px var(--sans); fill: var(--terracota-txt); }
  .mapa__ponto { fill: var(--linho); stroke: var(--tinta-suave); stroke-width: 1.5; }
  .mapa__arco { stroke: var(--floresta); stroke-width: 1.6; stroke-dasharray: 0.5 7; stroke-linecap: round; stroke-opacity: 0.55; }
  .mapa__dist {
    font: 600 11px var(--sans); letter-spacing: 0.12em; fill: var(--floresta);
    paint-order: stroke; stroke: var(--linho); stroke-width: 5px; stroke-linejoin: round;
  }

  .mapa__pin-corpo, .mapa__pin-txt, .mapa__onda-g { transform: translateY(var(--dy, 0px)) scale(var(--s, 1)); }
  .mapa__pin-disco { fill: var(--floresta); }
  .mapa__pin-logo { color: var(--linho); }
  .mapa__pin-txt {
    font: 600 14px var(--serif); fill: var(--floresta);
    paint-order: stroke; stroke: var(--linho); stroke-width: 5px; stroke-linejoin: round;
  }
  .mapa__onda {
    fill: none; stroke: var(--floresta); stroke-width: 1.5; opacity: 0;
    transform-box: fill-box; transform-origin: center;
    animation: mapa-onda 3.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  .mapa__onda--2 { animation-delay: 1.8s; }
  @keyframes mapa-onda {
    0% { transform: scale(1); opacity: 0.45; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  .mapa__abrir, .mapa__credito {
    position: absolute; font-size: 0.78rem; color: var(--tinta-suave);
  }
  .mapa__abrir {
    right: 14px; bottom: 12px; padding: 7px 12px; border-radius: 999px;
    background: color-mix(in srgb, var(--linho) 88%, transparent);
    box-shadow: inset 0 0 0 1px var(--linha); font-weight: 600; color: var(--floresta);
    transition: background 0.4s var(--ease), color 0.4s var(--ease);
  }
  .mapa__quadro:hover .mapa__abrir, .mapa__quadro:focus-visible .mapa__abrir { background: var(--floresta); color: var(--linho); }
  .mapa__credito { left: 14px; bottom: 12px; font-size: 0.68rem; opacity: 0.7; }
  .mapa__quadro:focus-visible { outline: 2px solid var(--floresta); outline-offset: 4px; }

  .mapa__titulo { font-size: clamp(1.6rem, 2.4vw, 2rem); color: var(--floresta); margin: 6px 0 10px; }
  .mapa__end { margin: 0 0 18px; color: var(--tinta); }
  .mapa__acesso { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 8px; color: var(--tinta-suave); font-size: 0.95rem; }
  .mapa__acesso li { padding-left: 22px; position: relative; }
  .mapa__acesso li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 8px; height: 8px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--floresta); }
  .mapa__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }

  /* Entrada (só com motion ativo; no Modo calmo tudo já aparece pronto) */
  :global(html.motion) .mapa:not(.is-visivel) .r--cant { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(html.motion) .mapa .r--cant { stroke-dasharray: 1; transition: stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s; }
  :global(html.motion) .mapa:not(.is-visivel) .mapa__ruas .r:not(.r--cant),
  :global(html.motion) .mapa:not(.is-visivel) .mapa__ref,
  :global(html.motion) .mapa:not(.is-visivel) .mapa__rua,
  :global(html.motion) .mapa:not(.is-visivel) .mapa__arco,
  :global(html.motion) .mapa:not(.is-visivel) .mapa__dist { opacity: 0; }
  :global(html.motion) .mapa .mapa__ruas .r:not(.r--cant),
  :global(html.motion) .mapa .mapa__ref,
  :global(html.motion) .mapa .mapa__rua,
  :global(html.motion) .mapa .mapa__arco,
  :global(html.motion) .mapa .mapa__dist { transition: opacity 1.2s var(--ease); }
  :global(html.motion) .mapa .mapa__ref, :global(html.motion) .mapa .mapa__rua { transition-delay: 0.9s; }
  :global(html.motion) .mapa .mapa__arco, :global(html.motion) .mapa .mapa__dist { transition-delay: 1.4s; }
  :global(html.motion) .mapa:not(.is-visivel) .mapa__pin-corpo,
  :global(html.motion) .mapa:not(.is-visivel) .mapa__pin-txt { opacity: 0; --dy: -22px; }
  :global(html.motion) .mapa .mapa__pin-corpo,
  :global(html.motion) .mapa .mapa__pin-txt {
    transition: opacity 0.6s var(--ease) 1.1s, transform 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s;
  }
  :global(html.motion) .mapa:not(.is-visivel) .mapa__onda { animation-play-state: paused; }

  @media (max-width: 960px) {
    .mapa { grid-template-columns: 1fr; }
    .mapa__quadro { aspect-ratio: 16 / 11; }
  }
  @media (max-width: 560px) {
    .mapa__quadro { aspect-ratio: 4 / 3; }
    .mapa__abrir { font-size: 0.72rem; right: 10px; bottom: 10px; }
    .mapa__credito { top: 10px; bottom: auto; left: 12px; font-size: 0.62rem; }
    /* Em tela pequena o mapa encolhe: textos e pino crescem em unidades do desenho para seguirem legíveis. */
    .mapa__ref-txt { font-size: 19px; stroke-width: 5px; }
    .mapa__ref-txt--metro { transform: translateY(8px); }
    .mapa__ref-txt--trimais { transform: translateY(6px); }
    .mapa__rua { font-size: 15.5px; }
    .mapa__dist { font-size: 16px; }
    .mapa__pin-txt { font-size: 21px; }
    .mapa__pin-corpo, .mapa__onda-g { --s: 1.45; }
    .mapa__pin-txt { --s: 1; transform: translateY(calc(var(--dy, 0px) - 10px)); }
    .mapa__ponto { r: 5; }
    .mapa__metro { --s: 1.4; }
  }
</style>

<script>
  const mapas = document.querySelectorAll<HTMLElement>("[data-mapa]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add("is-visivel"); io.unobserve(e.target); }
    }), { rootMargin: "0px 0px -18% 0px" });
    mapas.forEach((m) => io.observe(m));
  } else mapas.forEach((m) => m.classList.add("is-visivel"));
</script>
