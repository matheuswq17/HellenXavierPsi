---
import { site } from "../site.config";
import Triade from "./Triade.astro";
const t = site.tcc;
---
<section class="secao tcc" id="tcc" data-bg="#dfe5d8">
  <div class="wrap">
    <div class="tcc__topo">
      <div>
        <p class="eyebrow" data-reveal>Abordagem</p>
        <h2 data-split>O que você pensa, <em>sente e faz</em> está conectado.</h2>
      </div>
      <p class="lead" data-reveal>{t.texto}</p>
    </div>
    <p><a class="link" href="/psicoterapia-tcc">Como funciona o acompanhamento e a primeira sessão</a></p>
    <div data-reveal>
      <Triade cenarios={t.cenarios} aviso={t.aviso} />
    </div>
  </div>
</section>

<style>
  .tcc__topo { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: end; margin-bottom: clamp(48px, 7vw, 88px); }
  .tcc__topo .lead { max-width: 46ch; margin: 0; }
  @media (max-width: 860px) { .tcc__topo { grid-template-columns: 1fr; gap: 24px; } }

  :global(.triade) {
    display: grid; grid-template-columns: minmax(280px, 0.9fr) 1.3fr; gap: clamp(32px, 5vw, 80px);
    background: color-mix(in srgb, var(--linho) 70%, transparent);
    border-radius: 28px; padding: clamp(24px, 4vw, 56px);
    box-shadow: inset 0 0 0 1px var(--linha);
  }
  :global(.triade__rot) { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--tinta-suave); margin-bottom: 14px; }
  :global(.triade__chips) { display: grid; gap: 10px; }
  :global(.triade__chip) {
    text-align: left; padding: 14px 18px; border-radius: 16px; border: 0; cursor: pointer; font-size: 0.98rem;
    background: transparent; box-shadow: inset 0 0 0 1px var(--linha); color: var(--tinta);
    transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease), color 0.4s var(--ease);
  }
  :global(.triade__chip:hover) { background: var(--linho); }
  :global(.triade__chip[aria-checked="true"]) { background: var(--floresta); color: var(--linho); box-shadow: none; }
  :global(.triade__modo) { display: flex; align-items: center; gap: 12px; margin-top: 32px; font-size: 0.86rem; color: var(--tinta-suave); flex-wrap: wrap; }
  :global(.triade__modo .on) { color: var(--floresta); font-weight: 600; }
  :global(.triade__switch) {
    width: 52px; height: 30px; border-radius: 99px; border: 0; background: var(--areia); position: relative; cursor: pointer;
    transition: background 0.5s var(--ease); flex: none;
  }
  :global(.triade__switch span) {
    position: absolute; top: 4px; left: 4px; width: 22px; height: 22px; border-radius: 50%; background: var(--linho);
    box-shadow: 0 1px 3px rgba(0,0,0,.15); transition: transform 0.5s var(--ease);
  }
  :global(.triade__switch[aria-checked="true"]) { background: var(--floresta); }
  :global(.triade__switch[aria-checked="true"] span) { transform: translateX(22px); }
  :global(.triade__btn) { margin-top: 24px; --h: 50px; font-size: 0.95rem; }
  :global(.triade__aviso) { font-size: 0.8rem; color: var(--tinta-suave); margin-top: 20px; }

  :global(.triade__palco) { position: relative; min-height: 460px; }
  :global(.triade__linhas) { position: absolute; inset: 40px 12% 56px; width: 76%; height: calc(100% - 96px); overflow: visible; }
  :global(.triade__trilho) { fill: none; stroke: var(--linha); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  :global(.triade__fluxo) {
    fill: none; stroke: var(--terracota); stroke-width: 2; vector-effect: non-scaling-stroke;
    stroke-dasharray: 6 94; stroke-linecap: round;
    animation: fluxo 3.2s linear infinite; transition: stroke 0.8s var(--ease);
  }
  :global(.triade.is-alt .triade__fluxo) { stroke: var(--floresta-2); animation-duration: 5s; }
  @keyframes fluxo { to { stroke-dashoffset: -100; } }

  :global(.triade__no) {
    position: absolute; width: min(250px, 44%); background: var(--linho); border-radius: 20px; padding: 16px 18px;
    box-shadow: 0 18px 40px -26px rgba(22, 48, 31, 0.45), inset 0 0 0 1px var(--linha);
    transition: box-shadow 0.6s var(--ease), background 0.6s var(--ease);
  }
  :global(.triade.is-alt .triade__no) { background: #fff; }
  :global(.triade__no--p) { left: 50%; top: 0; translate: -50% 0; }
  :global(.triade__no--e) { left: 0; bottom: 36px; }
  :global(.triade__no--c) { right: 0; bottom: 36px; }
  :global(.triade__tag) { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; color: var(--terracota-txt); transition: color 0.6s; }
  :global(.triade.is-alt .triade__tag) { color: var(--floresta-2); }
  :global(.triade__val) { margin: 6px 0 0; font-family: var(--serif); font-size: 1.08rem; line-height: 1.35; color: var(--tinta); animation: troca 0.7s var(--ease) both; }
  @keyframes troca { from { opacity: 0; transform: translateY(8px); filter: blur(3px); } }
  :global(.triade__situacao) {
    position: absolute; left: 50%; top: 52%; translate: -50% -50%; width: 38%; text-align: center; margin: 0;
    font-size: 0.92rem; color: var(--tinta-suave); line-height: 1.4;
  }
  :global(.triade__situacao span:not([data-situacao])) { display: block; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; margin-bottom: 6px; }

  @media (max-width: 960px) {
    :global(.triade) { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    :global(.triade__palco) { min-height: 0; display: grid; gap: 14px; }
    :global(.triade__linhas) { display: none; }
    :global(.triade__no) { position: relative; width: auto; left: auto !important; right: auto !important; top: auto; bottom: auto !important; translate: none; }
    :global(.triade__situacao) { position: static; translate: none; width: auto; order: -1; text-align: left; }
  }
</style>
