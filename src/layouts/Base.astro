---
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/manrope/index.css";
import "../styles/global.css";
import { site } from "../site.config";
import { plain } from "../lib/text";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsFloat from "../components/WhatsFloat.astro";
import Respire from "../components/Respire.astro";
import Intro from "../components/Intro.astro";
import ogImg from "../assets/fotos/consultorio-psicologia-tucuruvi-hellen-xavier.jpg";
import retratoImg from "../assets/fotos/hellen-xavier-retrato.jpg";
import { getImage } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  mensagem?: string;
  noindex?: boolean;
  /** Nós extras de dados estruturados (Service, BreadcrumbList…) para a página. */
  ld?: Record<string, unknown>[];
  /** Abertura animada com o logo (só a home usa). */
  intro?: boolean;
}
const { title = site.seo.title, description = site.seo.description, mensagem = site.mensagens.geral } = Astro.props;
const indexavel = Boolean(import.meta.env.PUBLIC_SITE_URL) && !Astro.props.noindex && Astro.url.pathname !== "/404.html";
const canonical = new URL(Astro.url.pathname, site.url).toString();
const og = await getImage({ src: ogImg, width: 1200, height: 630, format: "jpg", fit: "cover" });
const retrato = await getImage({ src: retratoImg, width: 800, format: "jpg" });
const c = site.contato;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": `${site.url}/#consultorio`,
      name: `${site.nomeCompleto} · Psicóloga`,
      legalName: site.empresa,
      email: c.email,
      description: site.seo.description,
      url: site.url,
      image: new URL(og.src, site.url).toString(),
      telephone: `+${c.whatsapp}`,
      address: {
        "@type": "PostalAddress",
        streetAddress: `${c.endereco} (${c.predio})`,
        addressLocality: "São Paulo",
        addressRegion: "SP",
        postalCode: plain(c.cep),
        addressCountry: "BR",
      },
      areaServed: [
        ...c.bairros.map((b) => ({ "@type": "Place", name: `${b}, São Paulo - SP` })),
        { "@type": "Country", name: "Brasil (atendimento online)" },
      ],
      hasMap: c.mapsUrl,
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: site.horarios.dias,
        opens: site.horarios.abre,
        closes: site.horarios.fecha,
      },
      taxID: site.cnpj,
      currenciesAccepted: "BRL",
      amenityFeature: [{ "@type": "LocationFeatureSpecification", name: "Estacionamento no local", value: true }],
      availableService: [
        { "@id": `${site.url}/psicoterapia-tcc/#servico` },
        { "@id": `${site.url}/avaliacao-neuropsicologica/#servico` },
      ],
      sameAs: [plain(c.instagram)],
      founder: { "@id": `${site.url}/#hellen` },
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#hellen`,
      name: site.nomeCompleto,
      jobTitle: site.titulo,
      image: new URL(retrato.src, site.url).toString(),
      url: site.url,
      sameAs: [plain(c.instagram)],
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "Universidade Guarulhos (UnG)" },
        { "@type": "CollegeOrUniversity", name: "Universidade Federal de São Paulo (Unifesp)" },
        { "@type": "EducationalOrganization", name: "IPAF" },
        { "@type": "EducationalOrganization", name: "CEPS" },
        { "@type": "EducationalOrganization", name: "CETCC" },
      ],
      worksFor: { "@id": `${site.url}/#consultorio` },
      knowsAbout: ["Terapia Cognitivo-Comportamental", "Avaliação Neuropsicológica", "Psicoterapia", "Dependência Química", "Psicopatologia", "TDAH"],
      hasCredential: { "@type": "EducationalOccupationalCredential", credentialCategory: "Registro profissional", name: site.crp },
    },
    ...(Astro.props.ld ?? []),
  ],
};
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexavel && <link rel="canonical" href={canonical} />}
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#faf5f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.nome} · Psicóloga`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, site.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Consultório de psicologia de Hellen Xavier no Tucuruvi, com a psicóloga sentada em uma poltrona clara" />
    <meta name="twitter:card" content="summary_large_image" />
    {indexavel && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Antes da pintura: modo calmo, horário e motion (evita "piscar")
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        var calmo = false;
        try { calmo = localStorage.getItem("calmo") === "1"; } catch (e) {}
        var reduz = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (calmo || reduz) d.setAttribute("data-calmo", "");

        var h = new Date().getHours();
        if (h >= 18 || h < 6) d.classList.add("noite");
      })();
    </script>
    {Astro.props.intro && (
      <script is:inline>
        // Abertura: uma vez por sessão, nunca no Modo calmo/movimento reduzido nem em link com âncora.
        (function () {
          var d = document.documentElement;
          if (d.hasAttribute("data-calmo") || location.hash || navigator.webdriver) return;
          try { if (sessionStorage.getItem("intro")) return; } catch (e) { return; }
          d.classList.add("com-intro");
          var l = document.createElement("link");
          l.rel = "preload"; l.as = "image"; l.href = "/intro/crescimento.webp";
          document.head.appendChild(l);
          // Rede de segurança: se o script da abertura falhar, o site aparece sozinho.
          window.__introFalha = setTimeout(function () {
            d.classList.remove("com-intro");
            document.dispatchEvent(new Event("intro:fim"));
          }, 8000);
        })();
      </script>
    )}
  </head>
  <body>
    {Astro.props.intro && <Intro />}
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header mensagem={mensagem} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer mensagem={mensagem} />
    <WhatsFloat mensagem={mensagem} />
    <Respire />
    <script>
      import "../scripts/motion.ts";
    </script>
    <style>
      .pular {
        position: fixed; left: 16px; top: -80px; z-index: 100;
        background: var(--floresta); color: var(--linho);
        padding: 12px 18px; border-radius: 12px; text-decoration: none;
      }
      .pular:focus { top: 16px; }
    </style>
  </body>
</html>
