---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import MapaFuncoes from "../components/MapaFuncoes.astro";
import Duvidas from "../components/Duvidas.astro";
import { site } from "../site.config";
import { rich, waLink } from "../lib/text";
import foto from "../assets/fotos/hellen-xavier-avaliacao-neuropsicologica.jpg";
const a = site.avaliacao;
const url = `${site.url}/avaliacao-neuropsicologica/`;
const ld = [
  {
    "@type": "Service",
    "@id": `${url}#servico`,
    name: "Avaliação neuropsicológica",
    serviceType: "Avaliação neuropsicológica",
    description:
      "Avaliação neuropsicológica para adolescentes a partir de 12 anos e adultos no Tucuruvi, São Paulo: atenção, memória, linguagem, funções executivas e percepção, com entrevista, testes, laudo e devolutiva.",
    provider: { "@id": `${site.url}/#hellen` },
    areaServed: { "@type": "City", name: "São Paulo" },
    audience: [
      { "@type": "PeopleAudience", audienceType: "Adolescentes", suggestedMinAge: 12 },
      { "@type": "PeopleAudience", audienceType: "Adultos" },
    ],
    url,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Avaliação neuropsicológica", item: url },
    ],
  },
];
---
<Base
  title="Avaliação Neuropsicológica no Tucuruvi | Hellen Xavier"
  description="Avaliação neuropsicológica para adolescentes (a partir de 12 anos) e adultos no Tucuruvi, Zona Norte de SP: TDAH, TEA, aprendizagem, memória e atenção. Etapas, laudo e devolutiva."
  ld={ld}
  mensagem={site.mensagens.avaliacao}
>
  <section class="secao ap-hero" data-hero data-bg="#faf5f0">
    <div class="wrap ap-hero__grid">
      <div>
        <nav class="migalha" aria-label="Você está em"><a href="/">Início</a> <span aria-hidden="true">/</span> Avaliação neuropsicológica</nav>
        <p class="eyebrow" data-reveal>Adolescentes a partir de 12 anos e adultos · Zona Norte de SP</p>
        <h1 data-split>Avaliação neuropsicológica <em>no Tucuruvi.</em></h1>
        <p class="lead" data-reveal>{a.resumo}</p>
        <div class="ap-hero__cta" data-reveal>
          <a class="btn" href={waLink(site.contato.whatsapp, site.mensagens.avaliacao)} data-origem="pagina-avaliacao" target="_blank" rel="noopener">Tirar dúvidas sobre a avaliação</a>
        </div>
      </div>
      <div class="ap-hero__foto" data-reveal>
        <Picture src={foto} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(max-width: 860px) 90vw, 40vw" loading="eager"
          alt="Hellen Xavier sentada em uma poltrona no consultório, de blazer preto" />
      </div>
    </div>
  </section>

  <section class="secao" data-bg="#f4ece2">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Para quem é</p>
      <h2 data-split>Quando a avaliação <em>pode ajudar</em></h2>
      <ul class="ap-lista">
        {a.paraQuem.map((p) => <li data-reveal>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="secao" data-bg="#faf5f0">
    <div class="wrap ap-texto">
      <p class="eyebrow" data-reveal>Perguntas mais comuns</p>
      <h2 data-split>TDAH, TEA e aprendizagem: <em>o que a avaliação responde</em></h2>
      <h3>Avaliação de TDAH em adolescentes e adultos</h3>
      <p>Dificuldade de manter o foco, desorganização, procrastinação e impulsividade podem ter várias causas: TDAH, ansiedade, alterações do sono, humor ou simplesmente uma rotina sobrecarregada. A avaliação neuropsicológica ajuda a diferenciar essas possibilidades ao combinar a história de vida, questionários, relatos de pessoas próximas e testes de atenção e funções executivas. O resultado orienta o médico, a escola e a própria pessoa sobre os próximos passos.</p>
      <h3>Investigação de TEA</h3>
      <p>Na suspeita de Transtorno do Espectro Autista, a avaliação investiga comunicação, interação social, flexibilidade e o perfil cognitivo, integrando entrevistas com a família quando possível. O diagnóstico é clínico e, muitas vezes, construído em conjunto com outros profissionais, como psiquiatras e neurologistas.</p>
      <h3>Dificuldades de aprendizagem e desempenho escolar</h3>
      <p>Quando o desempenho não acompanha o esforço, a avaliação mapeia leitura, escrita, memória, atenção e raciocínio para entender onde está a dificuldade e o que pode ajudar em casa e na escola.</p>
      <h3>O que é o laudo e para que serve</h3>
      <p>O laudo é um documento técnico que descreve os instrumentos usados, os resultados e as conclusões da avaliação, com orientações práticas. Ele é explicado em uma sessão de devolutiva e pode ser compartilhado com médicos, escola e outros profissionais, sempre com a sua autorização.</p>
      <h3>Valores e prazos</h3>
      <p>A avaliação tem em torno de 6 sessões, incluindo entrevista, testagem e devolutiva, dependendo do ritmo do avaliado e da pergunta a ser respondida; a estimativa é apresentada após a entrevista inicial. Os valores e as formas de pagamento são informados no primeiro contato pelo WhatsApp. {site.horarios.resposta}</p>
    </div>
  </section>

  <section class="secao" id="funcoes" data-bg="#faf5f0">
    <div class="wrap">
      <p class="eyebrow" data-reveal>O que é investigado</p>
      <h2 data-split>Um mapa das <em>funções cognitivas</em></h2>
      <div class="ap-mapa" data-reveal><MapaFuncoes /></div>
      <dl class="ap-funcoes">
        {a.funcoes.map((f) => (
          <div data-reveal><dt>{f.nome}</dt><dd>{f.investiga}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="secao" data-bg="#dfe5d8">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Como funciona</p>
      <h2 data-split>Quatro etapas, <em>sem mistério.</em></h2>
      <ol class="ap-etapas">
        {a.etapas.map((e, i) => (
          <li data-reveal>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <div><h3>{e.titulo}</h3><p set:html={rich(e.texto)} /></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Duvidas itens={a.faq} titulo="Dúvidas sobre a avaliação" comGuia={false} id="duvidas-avaliacao" />
</Base>

<style>
  .ap-hero { padding-top: calc(84px + clamp(48px, 8vw, 110px)); }
  .ap-hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(40px, 6vw, 100px); align-items: center; }
  .ap-hero h1 { font-size: clamp(2.6rem, 5.4vw, 5rem); }
  .ap-hero .lead { margin-top: 28px; max-width: 48ch; }
  .ap-hero__cta { margin-top: 36px; }
  .ap-hero__foto :global(img) { border-radius: var(--radius); width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .ap-lista { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px; }
  .ap-lista li { font-family: var(--serif); font-size: 1.3rem; line-height: 1.3; padding: 24px; border-radius: 20px; background: var(--linho); }
  .ap-mapa { margin-top: 56px; }
  .ap-etapas { list-style: none; padding: 0; margin: 56px 0 0; display: grid; gap: 0; }
  .ap-etapas li { display: grid; grid-template-columns: 90px 1fr; gap: 24px; padding: 32px 0; border-top: 1px solid var(--linha); }
  .ap-etapas .num { font-size: 2.6rem; color: var(--floresta); line-height: 1; }
  .ap-etapas h3 { margin-bottom: 8px; }
  .ap-etapas p { color: var(--tinta-suave); max-width: 60ch; margin: 0; }
  @media (max-width: 860px) { .ap-hero__grid { grid-template-columns: 1fr; } .ap-etapas li { grid-template-columns: 56px 1fr; } }
  .ap-funcoes { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; margin: 56px 0 0; padding-top: 32px; border-top: 1px solid var(--linha); }
  .ap-funcoes dt { font-family: var(--serif); font-size: 1.2rem; color: var(--floresta); margin-bottom: 6px; }
  .ap-funcoes dd { margin: 0; color: var(--tinta-suave); font-size: .95rem; }
  @media (max-width: 960px) { .ap-funcoes { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .ap-funcoes { grid-template-columns: 1fr; } }
  .migalha { font-size: .85rem; color: var(--tinta-suave); margin-bottom: 20px; }
  .migalha a { color: var(--floresta); }
  .ap-texto { max-width: 820px; }
  .ap-texto h3 { font-size: clamp(1.3rem, 2vw, 1.6rem); margin: 40px 0 12px; color: var(--floresta); }
  .ap-texto p { color: var(--tinta-suave); }
</style>
