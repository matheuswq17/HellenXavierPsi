---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import MapaFuncoes from "../components/MapaFuncoes.astro";
import Duvidas from "../components/Duvidas.astro";
import { site } from "../site.config";
import { rich, waLink } from "../lib/text";
import foto from "../assets/fotos/poltrona-preto.jpg";
const a = site.avaliacao;
---
<Base
  title="Avaliação Neuropsicológica no Tucuruvi | Hellen Xavier"
  description="Avaliação neuropsicológica para adolescentes e adultos no Tucuruvi, Zona Norte de São Paulo: TDAH, TEA, aprendizagem, memória e atenção. Etapas, laudo e devolutiva."
  mensagem={site.mensagens.avaliacao}
>
  <section class="secao ap-hero" data-hero data-bg="#faf5f0">
    <div class="wrap ap-hero__grid">
      <div>
        <p class="eyebrow" data-reveal>Avaliação Neuropsicológica · Tucuruvi e Zona Norte de SP</p>
        <h1 data-split>Avaliação neuropsicológica <em>no Tucuruvi.</em></h1>
        <p class="lead" data-reveal>{a.resumo}</p>
        <div class="ap-hero__cta" data-reveal>
          <a class="btn" href={waLink(site.contato.whatsapp, site.mensagens.avaliacao)} target="_blank" rel="noopener">Tirar dúvidas sobre a avaliação</a>
        </div>
      </div>
      <div class="ap-hero__foto" data-reveal>
        <Picture src={foto} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(max-width: 860px) 90vw, 40vw" loading="eager"
          alt="Hellen Xavier sentada em uma poltrona no consultório, de blazer preto" />
      </div>
    </div>
  </section>

  <section class="secao" data-bg="#f4ece2">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Para quem é</p>
      <h2 data-split>Quando a avaliação <em>pode ajudar</em></h2>
      <ul class="ap-lista">
        {a.paraQuem.map((p) => <li data-reveal>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="secao" data-bg="#faf5f0">
    <div class="wrap">
      <p class="eyebrow" data-reveal>O que é investigado</p>
      <h2 data-split>Um mapa das <em>funções cognitivas</em></h2>
      <div class="ap-mapa" data-reveal><MapaFuncoes /></div>
    </div>
  </section>

  <section class="secao" data-bg="#dfe5d8">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Como funciona</p>
      <h2 data-split>Quatro etapas, <em>sem mistério.</em></h2>
      <ol class="ap-etapas">
        {a.etapas.map((e, i) => (
          <li data-reveal>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <div><h3>{e.titulo}</h3><p set:html={rich(e.texto)} /></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Duvidas itens={a.faq} titulo="Dúvidas sobre a avaliação" comGuia={false} id="duvidas-avaliacao" />
</Base>

<style>
  .ap-hero { padding-top: calc(84px + clamp(48px, 8vw, 110px)); }
  .ap-hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(40px, 6vw, 100px); align-items: center; }
  .ap-hero h1 { font-size: clamp(2.6rem, 5.4vw, 5rem); }
  .ap-hero .lead { margin-top: 28px; max-width: 48ch; }
  .ap-hero__cta { margin-top: 36px; }
  .ap-hero__foto :global(img) { border-radius: var(--radius); width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .ap-lista { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px; }
  .ap-lista li { font-family: var(--serif); font-size: 1.3rem; line-height: 1.3; padding: 24px; border-radius: 20px; background: var(--linho); }
  .ap-mapa { margin-top: 56px; }
  .ap-etapas { list-style: none; padding: 0; margin: 56px 0 0; display: grid; gap: 0; }
  .ap-etapas li { display: grid; grid-template-columns: 90px 1fr; gap: 24px; padding: 32px 0; border-top: 1px solid var(--linha); }
  .ap-etapas .num { font-size: 2.6rem; color: var(--floresta); line-height: 1; }
  .ap-etapas h3 { margin-bottom: 8px; }
  .ap-etapas p { color: var(--tinta-suave); max-width: 60ch; margin: 0; }
  @media (max-width: 860px) { .ap-hero__grid { grid-template-columns: 1fr; } .ap-etapas li { grid-template-columns: 56px 1fr; } }
</style>
